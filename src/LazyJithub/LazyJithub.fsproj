<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>lazyjithub</AssemblyName>
    <RootNamespace>LazyJithub</RootNamespace>
    <Nullable>disable</Nullable>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lazyjithub</ToolCommandName>
    <PackageId>LazyJithub</PackageId>
    <Version>0.1.0</Version>
    <Description>A read-only, lazygit-style terminal UI for GitHub Projects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="ReadOnly.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Text.fs" />
    <Compile Include="Rich.fs" />
    <Compile Include="Markdown.fs" />
    <Compile Include="GitHub.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Help.fs" />
    <Compile Include="Ui/Theme.fs" />
    <Compile Include="Ui/Widgets.fs" />
    <Compile Include="Ui/Dialogs.fs" />
    <Compile Include="Ui/App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
